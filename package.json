{
  "name": "banco_postgres",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:setup && jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:setup": "docker-compose -f docker-compose.test.yml up -d && timeout /t 5 /nobreak > nul && set DATABASE_URL=postgresql://postgres:postgres@localhost:5433/test_db && npx prisma migrate dev --name init --schema=./prisma/schema.prisma",
    "test:teardown": "docker-compose -f docker-compose.test.yml down",
    "setup-db": "npx prisma migrate dev --name init",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "crud": "npx ts-node crud-usuarios.ts",
    "dev": "npx ts-node server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.6",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
